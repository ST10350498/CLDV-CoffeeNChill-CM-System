      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"Hot Drinks\",\n  \"sku\": \"COF-001\",\n  \"name\": \"Espresso\",\n  \"description\": \"Strong single shot of espresso\",\n  \"price\": 2.50,\n  \"isAvailable\": true\n}"
        },
        "url": {
          "raw": "http://localhost:7071/api/menu",
          "protocol": "http",
          "host": ["localhost"],
          "port": "7071",
          "path": ["api", "menu"]
        }
      }
    },
